/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://formsubmit.co https://api.web3forms.com; form-action 'self' https://formsubmit.co; frame-src https://formsubmit.co; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=604800

# 静态资源都带 ?v=YYYYMMDDx 版本串，改内容必须同时改版本串，因此可放心长缓存
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# i18n 语言包只在生成脚本时按需加载，不参与长缓存
/i18n/*.js
  Cache-Control: public, max-age=600

/*.html
  Cache-Control: public, max-age=0, must-revalidate
